# Copy to .env.local and fill in what you need. .env.local is git-ignored.

# Optional, LOCAL DEVELOPMENT ONLY.
# A key placed here is bundled into the browser build and is therefore public.
# Leave it empty and let the user paste a key in the app instead.
VITE_GEMINI_API_KEY=

# Optional. Point the app at your own backend that holds the API key.
# When set, the browser never talks to Google directly.
VITE_API_BASE_URL=
